# Copy to .env for local dev (npm run dev). On Vercel, set these in Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Or use OpenRouter instead of Claude (takes priority when set). Default model is a
# cheap Qwen; override with OPENROUTER_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Free key from https://openalex.org/settings/api (required since Feb 2026; keyless ≈ 10 searches/day)
OPENALEX_API_KEY=
# Optional shared key; must match EXPO_PUBLIC_LABMATE_APP_KEY in the app
LABMATE_APP_KEY=
