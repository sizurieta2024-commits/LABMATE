# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so never put real secrets here.

# Labmate API (server/). Local: your computer's LAN IP, e.g. http://192.168.1.20:8787. Deployed: https://<project>.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:8787
# Must match LABMATE_APP_KEY on the server (light abuse protection)
EXPO_PUBLIC_LABMATE_APP_KEY=

# OpenAlex polite pool (optional but recommended): your email
EXPO_PUBLIC_OPENALEX_EMAIL=
EXPO_PUBLIC_OPENALEX_API_KEY=

# RevenueCat public SDK keys (dashboard → Project settings → API keys).
# The Test Store key works without App Store / Play accounts, great for the demo.
EXPO_PUBLIC_RC_TEST_KEY=
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# RevenueCat Web Purchase Link for "Ask a parent to pay" (dashboard → Web → Web Purchase Links)
EXPO_PUBLIC_RC_WEB_PURCHASE_URL=
